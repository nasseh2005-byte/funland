---
import Icon from './Icon.astro';
import Waves from './Waves.astro';
import {tr,href,asset,site,type Lang} from '../lib/site';
const {lang}=Astro.props as {lang:Lang};
const t=(ar:string,en:string)=>tr(lang,ar,en);
const steps=[
 [t('عرّفونا بالمجموعة','Tell us about your group'),t('اسم الجهة، عدد المشاركين والمرافقين، والفئة العمرية التقريبية.','Organization, participant and accompanying-adult counts, and approximate age range.')],
 [t('نراجع تفاصيل الزيارة','Review the visit details'),t('الموعد والمدة والألعاب المناسبة، ثم الخدمات المطلوبة والتكلفة وشروط الزيارة.','Date, duration and suitable games, followed by required services, cost and visit terms.')],
 [t('التأكيد قبل الانطلاق','Confirm before setting off'),t('لا يُعتمد الموعد إلا بعد اتفاق مباشر. احتفظوا بتفاصيل الاتفاق وبيانات مسؤول المجموعة.','The visit is confirmed only by direct agreement. Keep the agreed details and group organizer’s contact information.')]
];
const questions=[
 [t('هل توجد باقة ثابتة للمدارس؟','Is there a fixed school package?'),t('لم تُنشر باقات رحلات معتمدة بعد. يُحدَّد السعر وما يشمله مع المؤسسة حسب تفاصيل المجموعة، ولا تعرض هذه الصفحة سعرًا أو خدمة مضمونة.','Confirmed trip packages have not been published yet. Pricing and inclusions are agreed with the establishment based on the group details.')],
 [t('هل النقل والوجبات والمشرفون مشمولون؟','Are transport, meals and supervisors included?'),t('لا تفترضوا شمول أي منها. اطلبوا تحديد النقل والوجبات والإشراف وعدد المرافقين المسموح به كتابةً ضمن الاتفاق.','Please do not assume these are included. Ask for transport, meals, supervision and accompanying-adult allowances to be specified in the agreement.')],
 [t('ما الأعمار المناسبة للرحلة؟','What ages are suitable?'),t('تختلف شروط العمر والطول باختلاف اللعبة. اذكروا الفئة العمرية التقريبية عند التنسيق ليُراجع مدى ملاءمة التجارب، دون مشاركة أسماء الأطفال أو تواريخ ميلادهم.','Age and height requirements differ between rides. Share an approximate age range so suitability can be reviewed, without children’s names or dates of birth.')],
 [t('كيف نتعامل مع تعديل الموعد أو الإلغاء؟','What if the date changes or the trip is cancelled?'),t('تُطلب سياسة التعديل والإلغاء والاسترجاع من المؤسسة قبل تأكيد الزيارة أو دفع أي مبلغ. لا توجد سياسة منشورة نعتمدها حاليًا.','Request the establishment’s change, cancellation and refund terms before confirming a visit or paying. No confirmed policy is currently published.')],
 [t('هل النموذج يؤكد الحجز؟','Does this form confirm a booking?'),t('لا. النموذج يجهز ملخصًا لطلب التنسيق فقط، ويمكن نسخه. لا يتم إرسال البيانات أو حفظها في الموقع، ولا يصبح الطلب حجزًا إلا بعد الاتفاق المباشر.','No. The form prepares a copyable enquiry summary. It does not send or store your data, and it does not create a booking. Confirmation requires a direct agreement.')]
];
---
<script src="../scripts/trips.ts"></script>
<section class="section container trip-intro"><div><div class="eyebrow">{t('طلعة جماعية بروح الجزيرة','AN ISLAND DAY, TOGETHER')}</div><h2>{t('رفقة حلوة،','Good company,')}<br/><span class="orange-word">{t('ويوم يستاهل.','a day to remember.')}</span></h2><p>{t('للمدارس والروضات والجهات والمجموعات العائلية: هذه الصفحة تساعدكم على تجهيز طلب واضح، ومعرفة التفاصيل التي تحتاج إلى اتفاق قبل الزيارة.','For schools, nurseries, organizations and family groups: prepare a clear enquiry and understand what needs to be agreed before your visit.')}</p><div class="button-row"><a class="button" href="#trip-request">{t('جهّز طلب الرحلة','Prepare a trip enquiry')}<Icon name="arrow" class="direction-arrow" size={20}/></a><a class="text-link" href={href(lang,'experiences')}>{t('استكشف الألعاب','Explore games')}<Icon name="wheel" size={20}/></a></div><p class="trip-availability">{t('تُراجع إمكانية استقبال المجموعة والمواعيد والخدمات مع المؤسسة قبل التأكيد.','Group availability, dates and services must be confirmed with the establishment.')}</p></div><figure class="trip-island"><img src={asset('images/island-beach.webp')} alt={t('رسم تصوري لشاطئ جزيرة المرح ونخيلها ومناطق الألعاب','Illustration of Fun Island’s beach, palms and game areas')} width="1600" height="914"/><figcaption>{t('كل رحلة تبدأ بفكرة حلوة.','Every trip starts with a good idea.')}</figcaption></figure></section>
<Waves/><section class="trip-steps-band"><div class="container"><div class="section-heading"><div><div class="eyebrow">{t('من الفكرة إلى الزيارة','FROM AN IDEA TO A VISIT')}</div><h2>{t('نرتّبها خطوة بخطوة.','Let’s plan it, step by step.')}</h2></div></div><div class="trip-steps">{steps.map(([title,description],index)=><article><span>0{index+1}</span><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
<section class="section container"><div class="section-heading"><div><div class="eyebrow">{t('اتفقوا على التفاصيل','AGREE ON THE DETAILS')}</div><h2>{t('قبل ما تقولون: يلا!','Before you say: let’s go!')}</h2></div></div><div class="trip-checklist">{[
 ['clock',t('الموعد والمدة','Date & duration'),t('وقت الوصول والمغادرة، وإمكانية استقبال المجموعة في اليوم المقترح.','Arrival and departure times, and group availability on your preferred day.')],
 ['people',t('المشاركون والمرافقون','Participants & adults'),t('عدد الأطفال أو الزوار، والفئات العمرية، ومسؤولية الإشراف والمرافقين.','Visitor counts, age ranges, and the responsibilities of supervisors and accompanying adults.')],
 ['wheel',t('الألعاب والخدمات','Games & services'),t('التجارب المشمولة، شروط الاستخدام، الوجبات أو الجلسات إن تم الاتفاق عليها.','Included experiences, ride requirements, and any agreed meals or seating.')],
 ['bag',t('التكلفة وشروط الاتفاق','Cost & terms'),t('السعر الإجمالي، طريقة الدفع، وأحكام التأجيل والإلغاء قبل الدفع.','Total price, payment method, and rescheduling and cancellation terms before payment.')]
 ].map(([icon,title,desc])=><article><Icon name={icon} size={27}/><h3>{title}</h3><p>{desc}</p></article>)}</div></section>
<section class="section container trip-form-section" id="trip-request"><div class="trip-form-aside"><div class="eyebrow">{t('خلّونا نبدأ بالتفاصيل','START WITH THE DETAILS')}</div><h2>{t('جهّزوا طلب','Prepare your')}<br/><span class="orange-word">{t('رحلتكم.','group enquiry.')}</span></h2><p>{t('اكتبوا معلومات أولية عن المجموعة؛ سيظهر ملخص منظم يمكن نسخه وإرساله عبر قناة التواصل المعتمدة عند توفرها.','Add a few details about your group. You’ll get an organized summary to copy and share through an approved contact channel once available.')}</p><p class="trip-availability">{t('النموذج لا يرسل البيانات ولا يؤكد الحجز. لا تضيفوا بيانات شخصية للأطفال.','This form does not send data or confirm a booking. Do not include children’s personal information.')}</p>{site.organization.email&&<a class="text-link" href={`mailto:${site.organization.email}`}>{site.organization.email}</a>}</div>
<form id="trip-form" class="trip-form"><div class="trip-fields">
<label>{t('نوع المجموعة','Group type')}<select name="groupType" required><option value="">{t('اختاروا النوع','Select a type')}</option>{[t('مدرسة','School'),t('روضة أو حضانة','Nursery / kindergarten'),t('جهة أو شركة','Organization / company'),t('مجموعة عائلية','Family group')].map(label=><option value={label}>{label}</option>)}</select></label>
<label>{t('اسم الجهة أو المجموعة','Organization / group name')}<input name="organization" required maxlength="100" autocomplete="organization"/></label>
<label>{t('اسم منسق الرحلة','Organizer name')}<input name="organizer" required maxlength="80" autocomplete="name"/></label>
<label>{t('التاريخ المقترح','Preferred date')}<input name="date" type="date" required/></label>
<label>{t('عدد المشاركين التقريبي','Approximate participant count')}<input name="participants" type="number" min="1" max="5000" step="1" required inputmode="numeric"/></label>
<label>{t('عدد المرافقين','Accompanying adult count')}<input name="adults" type="number" min="0" max="1000" step="1" required inputmode="numeric"/></label>
<label class="field-wide">{t('الفئة العمرية','Age range')}<select name="ageRange" required><option value="">{t('اختاروا الفئة التقريبية','Select an approximate range')}</option>{[t('أقل من 6 سنوات','Under 6'),t('6–9 سنوات','6–9 years'),t('10–12 سنة','10–12 years'),t('13 سنة فأكثر','13 and over'),t('أعمار مختلفة','Mixed ages')].map(label=><option value={label}>{label}</option>)}</select></label>
<label class="field-wide">{t('تفاصيل إضافية (اختياري)','Additional details (optional)')}<textarea name="notes" maxlength="1000" rows="3" placeholder={t('المدة المطلوبة أو أسئلة عن الخدمات؛ دون بيانات الأطفال','Preferred duration or service questions; no children’s personal data')}></textarea></label>
</div><noscript><p>{t('يحتاج تجهيز الملخص إلى تفعيل JavaScript؛ لم يتم إرسال أي بيانات.','Enable JavaScript to prepare the summary. No data has been sent.')}</p></noscript><button class="button" type="submit" disabled data-trip-submit>{t('جهّز ملخص الطلب','Prepare enquiry summary')}<Icon name="arrow" class="direction-arrow" size={18}/></button><p class="form-error" id="trip-error" role="alert"></p><section id="trip-result" class="trip-result" hidden aria-labelledby="trip-result-title"><h3 id="trip-result-title" tabindex="-1">{t('ملخص طلبكم جاهز','Your enquiry summary is ready')}</h3><p>{t('لم يتم إرسال الطلب أو تأكيد موعد. انسخوا التفاصيل للتنسيق مع المؤسسة.','Nothing has been sent or booked. Copy the details to coordinate with the establishment.')}</p><textarea id="trip-summary" readonly rows="10" aria-label={t('ملخص طلب التنسيق','Enquiry summary')}></textarea><button type="button" class="button button-yellow" id="copy-trip">{t('نسخ ملخص الطلب','Copy enquiry summary')}</button><span id="copy-feedback" role="status"></span></section></form></section>
<section class="section container" style="padding-top:0"><h2>{t('أسئلة منظمي الرحلات','Questions from trip organizers')}</h2><div class="faq">{questions.map(([q,a])=><details><summary>{q}<Icon name="plus" size={20}/></summary><p>{a}</p></details>)}</div></section>
