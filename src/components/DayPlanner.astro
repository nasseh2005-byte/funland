---
import Icon from './Icon.astro';
import {site, tr, href, asset, type Lang} from '../lib/site';
const {lang}=Astro.props as {lang:Lang};
const t=(ar:string,en:string)=>tr(lang,ar,en);
const routes=[
  {id:'family',icon:'wheel',label:t('على رواق','Easy-going'),title:t('يوم يجمع العائلة','A day together'),description:t('ابدأوا بجولة لطيفة، ثم اختاروا الضحكة التالية معًا.','Start gently, then pick the next laugh together.'),image:'carousel.webp',games:['train','carousel','arcade'],tone:'mint'},
  {id:'action',icon:'car',label:t('كله حماس','Full of energy'),title:t('من لعبة إلى تحدٍّ','From rides to challenges'),description:t('مسار لمن يحبون الحركة والانتقال من مغامرة إلى أخرى.','A route for those who love to keep moving.'),image:'bumper-cars.webp',games:['cars','jump','arcade'],tone:'sun'},
  {id:'mix',icon:'spark',label:t('شوية من كل شيء','A bit of everything'),title:t('خلّوها متنوعة','Mix it up'),description:t('لفة للعائلة، جرعة حماس، ونهاية بروح المنافسة.','A family ride, a little action, and a playful finish.'),image:'arcade.webp',games:['carousel','cars','arcade'],tone:'coral'}
];
const gameById=new Map(site.games.map(game=>[game.id,game]));
---
<script src="../scripts/day-planner.ts"></script>
<section class="day-planner section" id="day-planner" aria-labelledby="planner-title" data-day-planner>
  <div class="container">
    <div class="planner-heading"><div><span class="eyebrow"><Icon name="spark" size={18}/>{t('فكرة لطلعتكم','MAKE A DAY OF IT')}</span><h2 id="planner-title">{t('ارسموا مسار المرح.','Make your own fun route.')}</h2><p>{t('اختاروا الجو اللي يناسبكم، وتعرّفوا على ثلاث تجارب ممكن تبدأون منها.','Pick your kind of day and discover three experiences to start with.')}</p></div><span class="planner-stamp" aria-hidden="true">FUN<br/>ISLAND <Icon name="spark" size={17}/></span></div>
    <div class="planner-tabs" role="tablist" aria-label={t('نوع مسار الزيارة','Visit route type')}>
      {routes.map((route,index)=><button type="button" role="tab" id={'route-tab-'+route.id} aria-controls={'route-panel-'+route.id} aria-selected={index===0?'true':'false'} tabindex={index===0?'0':'-1'} data-route-tab={route.id}><Icon name={route.icon} size={22}/><span>{route.label}</span></button>)}
    </div>
    <div class="planner-panels">{routes.map((route,index)=><article class={'planner-panel '+route.tone} id={'route-panel-'+route.id} role="tabpanel" aria-labelledby={'route-tab-'+route.id} data-route-panel={route.id} hidden={index!==0}>
      <div class="planner-visual"><img src={asset('images/'+route.image)} alt={t('صورة تعبيرية لأجواء المسار','Illustrative photograph for this route')} width="800" height="750" loading="lazy"/><div class="planner-photo-note">{t('صور تعبيرية','Illustrative photos')}</div><div class="planner-visual-label"><small>{t('مسار مقترح','SUGGESTED ROUTE')} 0{index+1}</small><strong>{route.title}</strong></div></div>
      <div class="planner-ticket"><span class="planner-kicker">FUN ISLAND · {t('جدة','JEDDAH')}</span><h3>{route.title}</h3><p class="planner-description">{route.description}</p><ol class="planner-steps">{route.games.map((gameId,step)=>{const game=gameById.get(gameId)!;return <li><span class="planner-step-number">0{step+1}</span><div><strong>{game.title[lang]}</strong><small>{game.description[lang]}</small></div><a href={href(lang,'experiences')+'#'+game.id} aria-label={t('استكشف لعبة ','Explore ')+game.title[lang]}><Icon name="arrow" size={19} class="direction-arrow"/></a></li>})}</ol><p class="planner-caveat">{t('مسار استكشافي مقترح، وليس حجزًا أو جدول تشغيل. تحقّقوا من إتاحة الألعاب وشروطها قبل الزيارة.','An idea for exploring, not a booking or operating schedule. Check ride availability and requirements before visiting.')}</p></div>
    </article>)}</div>
  </div>
</section>
<style>
.day-planner{background:#efe3bc;position:relative;overflow:hidden;scroll-margin-top:115px}.day-planner:before{content:'';position:absolute;width:390px;height:390px;border:2px solid #d1a95245;border-radius:50%;top:-180px;inset-inline-end:-100px;box-shadow:0 0 0 45px #f6eac75c,0 0 0 90px #f6eac741;pointer-events:none}.planner-heading{display:flex;align-items:center;justify-content:space-between;gap:25px;margin-bottom:31px;position:relative}.planner-heading h2{font-size:clamp(39px,4.2vw,58px)}.planner-heading p{font-size:15px;margin-top:10px;max-width:610px}.planner-stamp{width:83px;height:83px;border:2px dashed #c25934;border-radius:50%;display:grid;place-items:center;text-align:center;line-height:1.2;font-size:12px;font-weight:800;letter-spacing:1px;color:#b14829;transform:rotate(12deg);flex:none}.planner-stamp svg{margin-top:-14px}.planner-tabs{display:flex;gap:10px;margin-bottom:17px;position:relative}.planner-tabs button{display:flex;align-items:center;justify-content:center;gap:10px;background:#fff8e8;border:1px solid #d8c8a0;border-radius:40px;padding:10px 23px;font-weight:750;min-height:50px;color:#2a4035;transition:transform .2s,background .2s}.planner-tabs button:hover{transform:translateY(-2px)}.planner-tabs button[aria-selected=true]{background:#263f32;color:#fff4d5;border-color:#263f32;box-shadow:0 4px 0 #b9a469}.planner-panel{display:grid;grid-template-columns:.85fr 1.15fr;min-height:570px;background:#fffaf0;border:1px solid #cbbd9e;border-radius:22px;overflow:hidden;box-shadow:0 16px 38px #5b452b17}.planner-panel[hidden]{display:none!important}.planner-visual{position:relative;min-height:570px;overflow:hidden;background:#886e43}.planner-visual img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.planner-visual:after{content:'';position:absolute;inset:40% 0 0;background:linear-gradient(transparent,#142e27bd)}.planner-photo-note{position:absolute;top:18px;inset-inline-start:18px;background:#fff9e7ec;border-radius:7px;padding:4px 10px;color:#284234;font-size:11px;z-index:1}.planner-visual-label{position:absolute;bottom:32px;inset-inline:30px;color:#fff8e9;z-index:1;display:grid;gap:3px}.planner-visual-label small{letter-spacing:1px;font-size:12px}.planner-visual-label strong{font-family:var(--heading);font-size:clamp(32px,3vw,43px);line-height:1.25}.planner-ticket{padding:36px clamp(27px,4vw,58px);color:#253b30;display:flex;flex-direction:column}.planner-kicker{letter-spacing:2px;font-size:11px;font-weight:800;color:#a7492b}.planner-ticket h3{font-size:clamp(30px,3vw,41px);margin-top:10px}.planner-description{font-size:15px;color:#516251;margin-top:8px}.planner-steps{list-style:none;margin:26px 0 0;padding:0;position:relative}.planner-steps:before{content:'';position:absolute;top:25px;bottom:28px;inset-inline-start:22px;border-inline-start:2px dashed #c0ae82}.planner-steps li{display:flex;align-items:center;gap:16px;position:relative;padding:0 0 18px}.planner-steps li:last-child{padding-bottom:0}.planner-step-number{width:46px;height:46px;border-radius:50%;background:#ffcf45;color:#233e30;display:grid;place-items:center;font-weight:800;flex:none;border:3px solid #fffaf0;box-shadow:0 0 0 1px #c6ad6c}.planner-steps li div{min-width:0;flex:1}.planner-steps strong{display:block;font-size:16px}.planner-steps small{display:block;color:#657067;font-size:12px;line-height:1.6;max-width:350px}.planner-steps a{width:37px;height:37px;border:1px solid #bdc6ad;border-radius:50%;display:grid;place-items:center;flex:none;transition:background .2s}.planner-steps a:hover{background:#ffcf45}.planner-caveat{border-top:1px dashed #cbbd9e;padding-top:14px;margin-top:auto;color:#646d60;font-size:11px;line-height:1.7}.planner-panel.sun .planner-step-number{background:#efb879}.planner-panel.coral .planner-step-number{background:#eea995}
:global([data-theme=dark]) .day-planner{background:#263b30;color:#f5edcf}:global([data-theme=dark]) .day-planner:before{border-color:#617c6555;box-shadow:0 0 0 45px #314c3a65,0 0 0 90px #30483740}:global([data-theme=dark]) .planner-tabs button{background:#1c3129;color:#f5edcf;border-color:#53644a}:global([data-theme=dark]) .planner-tabs button[aria-selected=true]{background:#e1b95e;color:#20372a;border-color:#e1b95e}:global([data-theme=dark]) .planner-panel{background:#20352c;border-color:#52684c}:global([data-theme=dark]) .planner-ticket{color:#f6edcf}:global([data-theme=dark]) .planner-description,:global([data-theme=dark]) .planner-steps small,:global([data-theme=dark]) .planner-caveat{color:#bacbb6}:global([data-theme=dark]) .planner-step-number{border-color:#20352c}
@media(max-width:850px){.planner-panel{grid-template-columns:.8fr 1.2fr}.planner-ticket{padding:28px}.planner-visual{min-height:580px}.planner-steps small{font-size:11px}}
@media(max-width:650px){.day-planner{padding-block:55px 60px}.planner-heading{margin-bottom:22px}.planner-heading h2{font-size:36px}.planner-heading p{font-size:13px}.planner-stamp{width:59px;height:59px;font-size:9px}.planner-stamp svg{width:12px;margin-top:-11px}.planner-tabs{gap:7px}.planner-tabs button{flex:1;flex-direction:column;gap:2px;padding:8px 5px;min-height:66px;border-radius:13px;font-size:11px;line-height:1.3;text-align:center}.planner-tabs button svg{width:20px;height:20px}.planner-panel{grid-template-columns:1fr}.planner-visual{min-height:225px}.planner-visual-label{bottom:20px;inset-inline:22px}.planner-visual-label strong{font-size:31px}.planner-ticket{padding:25px 22px 27px}.planner-ticket h3{font-size:30px}.planner-description{font-size:13px}.planner-steps{margin-top:22px}.planner-steps li{gap:10px;padding-bottom:17px}.planner-steps strong{font-size:14px}.planner-steps small{font-size:11px}.planner-caveat{margin-top:23px}}
@media(prefers-reduced-motion:reduce){.planner-tabs button,.planner-steps a{transition:none}}
</style>
