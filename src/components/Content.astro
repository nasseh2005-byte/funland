---
import Icon from './Icon.astro';
import {illustrativeImages as editorialImages,generatedGameIds} from '../lib/game-media';
import IslandMap from './IslandMap.astro';
import Waves from './Waves.astro';
import Trips from './Trips.astro';
import {site, tr, href, asset, titles, type Lang} from '../lib/site';
const {lang,page} = Astro.props as {lang:Lang,page:string};
const t=(ar:string,en:string)=>tr(lang,ar,en);
const intro:Record<string,string>={
 trips:t('من أول فكرة للرحلة إلى يوم الزيارة: معلومات تساعد المدارس والمجموعات على التنسيق بوضوح.','From the first idea to the day of the visit: information to help schools and groups coordinate with confidence.'),
 about:t('هوية سعودية في قطاع الترفيه. تعرّف على المؤسسة وأنشطتها وبياناتها التجارية.','A Saudi identity in the entertainment sector. Get to know our establishment, activities and registration details.'),
 experiences:t('من جولة القطار إلى قفزات الحماس وتحديات الأركيد؛ لكل تجربة متعتها، ولكل زيارة حكاية تجمع العائلة.','All aboard the train, into the air, or on to the next arcade challenge. Every adventure brings the family a new story to share.'),
 business:t('مساحة للتواصل المهني، والتعريف بأنشطة المؤسسة، واستكشاف فرص التعاون.','A space for professional connections, our establishment’s activities, and opportunities to collaborate.'),
 visit:t('كل زيارة جميلة تبدأ بتخطيط بسيط. راجع معلومات الفرع والتفاصيل المهمة قبل الانطلاق.','Every good visit starts with a little planning. Check branch information and useful details before setting off.'),
 offers:t('تعرّف على الباقات والعروض المعتمدة عند توفرها، واختر ما يناسب زيارتكم.','Discover confirmed packages and offers when available, and choose what suits your visit.'),
 privacy:t('معلومات واضحة عن البيانات التي يستخدمها هذا الموقع.','Clear information about how this website uses data.')
};
const activities=[
 {icon:'wheel',title:t('المدن ومراكز الترفيه','Amusement parks & centers'),description:t('أنشطة المدن الترفيهية ومراكز الترفيه.','Amusement park and entertainment center activities.')},
 {icon:'spark',title:t('الفعاليات الترفيهية','Entertainment events'),description:t('تنظيم الفعاليات الترفيهية ضمن أنشطة المؤسسة.','Entertainment event organization within the establishment’s activities.')},
 {icon:'bag',title:t('الألعاب والتجزئة','Toys & retail'),description:t('بيع الألعاب واللعب بالتجزئة في المتاجر المتخصصة.','Retail sale of games and toys in specialized stores.')},
 {icon:'cup',title:t('المأكولات الخفيفة','Food & refreshments'),description:t('نشاط محلات الوجبات السريعة ضمن السجل التجاري.','Fast-food outlet activity listed in the commercial registration.')}
];
const branch=site.branches[0];

const statusLabel=(status:string)=>status==='available'?t('متاحة حسب آخر تحديث','Available at last update'):status==='unavailable'?t('متوقفة مؤقتًا','Temporarily unavailable'):t('تحقق من الإتاحة','Check availability');
type Offer={id:string;title:{ar:string;en:string};description:{ar:string;en:string};amount?:number;start?:string;end?:string;published?:boolean};
const today=new Date().toLocaleDateString('en-CA',{timeZone:'Asia/Riyadh'});
const offers=(branch.offers as Offer[]).filter(o=>o.published&&(!o.start||o.start<=today)&&(!o.end||o.end>=today));
const pricing=(branch.pricing as Offer[]).filter(item=>item.published);
---
<section class="page-intro"><div class="container"><div class="breadcrumbs"><a href={href(lang)}>{t('الرئيسية','Home')}</a><span>/</span><span>{titles[page][lang]}</span></div><h1>{page==='experiences'?t('في جزيرتنا… لكل مغامرة حكاية','An island of adventures. A world of stories.'):titles[page][lang]}</h1><p>{intro[page]}</p></div></section>

{page==='experiences'&&<>
  <Waves/><section class="section container map-section"><div class="section-heading"><div><div class="eyebrow">{t('نظرة على عالم الجزيرة','A LOOK AT THE ISLAND')}</div><h2>{t('من أين تبدأ مغامرتكم؟','Where shall we start?')}</h2></div></div><IslandMap lang={lang} interactive/></section>
  <section class="section container"><div class="filters" role="group" aria-label={t('تصفية التجارب','Filter experiences')}>{[['all',t('كل التجارب','All experiences')],['family',t('لحظات عائلية','Family moments')],['adventure',t('حركة وحماس','Action & adventure')],['electronic',t('ألعاب إلكترونية','Electronic games')]].map(([id,label])=><button class="filter" data-filter={id} aria-pressed={id==='all'?'true':'false'}>{label}</button>)}<span class="filter-count" id="filter-count" aria-live="polite">{site.games.length} {t('تجارب','experiences')}</span></div>
  <div class="game-grid">{site.games.map(game=><article class="game-card" id={game.id} data-game-category={game.category}><div class="game-art">{game.image||editorialImages[game.id]?<><img src={asset(game.image||editorialImages[game.id])} alt={game.image?game.title[lang]:(generatedGameIds.has(game.id)?t('صورة مولّدة بالذكاء الاصطناعي: ','AI-generated illustration: '):t('صورة تعبيرية: ','Illustrative photograph: '))+game.title[lang]} loading="lazy" width="500" height="300"/>{!game.image&&<span class="game-photo-label">{generatedGameIds.has(game.id)?t('صورة مولّدة بالذكاء الاصطناعي','AI-generated image'):t('صورة تعبيرية','Illustrative photo')}</span>}</>:<Icon name={game.icon} size={63}/>}</div><div class="game-body"><span class:list={['status',game.status]}>{statusLabel(game.status)}</span><h3>{game.title[lang]}</h3><p>{game.description[lang]}</p><button data-open-game={game.id}>{t('تفاصيل التجربة','Experience details')}<Icon name="arrow" size={18} class="direction-arrow"/></button></div></article>)}</div><p class="section-note">{t('التصنيفات مستمدة من تصور الموقع. تُستكمل أسماء الألعاب الفعلية وشروطها وصورها بعد اعتماد بيانات التشغيل.','Categories reflect the website concept. Individual ride names, requirements and photos will be completed once operational details are confirmed.')}</p>

  </section>

</>}

{page==='business'&&<>
  <section class="section container content-grid"><div class="prose"><div class="eyebrow">FUN ISLAND · BUSINESS</div><h2>{t('لنتحدث عن فرص التعاون.','Let’s talk about collaboration.')}</h2><p>{t('للشركات والجهات ومنظمي الفعاليات الراغبين في التعرف على جزيرة المرح، نوفر تعريفًا بالمؤسسة وبياناتها المسجلة ونطاق أنشطتها.','For businesses, organizations and event planners interested in Fun Island, we provide an introduction to the establishment, its registration details and activity areas.')}</p><p>{t('تبدأ أي شراكة بفهم الاحتياج، وتحديد نطاق العمل، ثم الاتفاق على الإمكانات والتفاصيل. تُؤكد الخدمات والأسعار والمواعيد مباشرة مع المؤسسة.','Every partnership starts with understanding the need, defining the scope, and agreeing on capabilities and details. Services, pricing and schedules are confirmed directly with the establishment.')}</p><div class="button-row"><a class="button" href={href(lang,'business')+'#registration'}>{t('عرض بيانات المؤسسة','View establishment profile')}<Icon name="building" size={18}/></a></div></div><div class="info-panel"><h2>{t('لتجهيز طلب التعاون','Preparing a collaboration enquiry')}</h2><dl class="info-list"><div><dt>01</dt><dd>{t('اسم الجهة والشخص المسؤول','Organization and contact person')}</dd></div><div><dt>02</dt><dd>{t('نوع التعاون أو الفعالية','Type of collaboration or event')}</dd></div><div><dt>03</dt><dd>{t('المدينة والموقع المقترح','City and proposed location')}</dd></div><div><dt>04</dt><dd>{t('التاريخ المتوقع وحجم المشاركة','Expected date and scope')}</dd></div></dl><p class="info-note">{t('يكفي تقديم بيانات جهة التواصل؛ لا حاجة لإرسال معلومات شخصية عن الأطفال.','Contact-person details are sufficient. Children’s personal information is not needed.')}</p></div></section>

  <section class="section container content-grid"><div class="prose"><div class="eyebrow">{t('عن جزيرة المرح','ABOUT FUN ISLAND')}</div><h2>{t('بهجة للعائلة، وهوية واضحة للأعمال.','Joy for families. A clear business identity.')}</h2><p>{t('جزيرة المرح اسم يجمع تجارب الألعاب والترفيه العائلي. ومن خلال هذا الموقع، نقرّب صورة التجربة للزوار، ونقدم للجهات والشركات تعريفًا واضحًا بالمؤسسة وأنشطتها.','Fun Island brings together games and family entertainment. Through this website, we help visitors explore the experience and give businesses a clear introduction to the establishment and its activities.')}</p><p>{t('تعمل المؤسسة باسم «مؤسسة ملاهي جزيرة المرح الاقتصادية». وتشمل الأنشطة الواردة في بيانات سجلها المدن ومراكز الترفيه، وتنظيم الفعاليات الترفيهية، وتجارة الألعاب بالتجزئة، والوجبات السريعة.','The establishment operates under the Arabic legal name shown in its registration. Listed activities include amusement parks and centers, entertainment events, retail games and toys, and fast-food outlets.')}</p><div class="button-row no-print"><button class="text-link" id="print-profile" style="background:none;padding:0"><Icon name="download" size={18}/>{t('طباعة بيانات المؤسسة','Print establishment profile')}</button></div></div>
  <div class="info-panel" id="registration"><h2>{t('بيانات المؤسسة','Establishment details')}</h2><dl class="info-list"><div><dt>{t('الاسم القانوني','Legal name')}</dt><dd>{site.organization.name.ar}</dd></div><div><dt>{t('السجل التجاري','Commercial registration')}</dt><dd dir="ltr">{site.organization.registration}</dd></div><div><dt>{t('الرقم الوطني الموحد','Unified national number')}</dt><dd dir="ltr">{site.organization.unifiedNumber}</dd></div><div><dt>{t('تاريخ إصدار السجل','Registration issue date')}</dt><dd dir="ltr">{site.organization.issueDate}</dd></div><div><dt>{t('المدينة','City')}</dt><dd>{t('جدة، المملكة العربية السعودية','Jeddah, Saudi Arabia')}</dd></div></dl><p class="info-note">{t('البيانات التعريفية وفق مستند السجل المقدم للموقع. يُرجى الرجوع إلى الجهات الرسمية للتحقق من الحالة الحالية للسجل.','Identification details are based on the registration document provided to this website. Consult official channels to verify the current registration status.')}</p></div></section>
  <section class="section container" style="padding-top:0"><div class="eyebrow">{t('مجالات النشاط','ACTIVITY AREAS')}</div><h2>{t('أنشطة تجمع الترفيه والتجربة.','Activities built around entertainment.')}</h2><div class="activities">{activities.map(item=><article class="activity"><Icon name={item.icon} size={32}/><h3>{item.title}</h3><p>{item.description}</p></article>)}</div><p class="section-note">{t('تصنيف الأنشطة في السجل لا يعني توفر كل خدمة في كل فرع؛ تُحدد الخدمات المتاحة بالتواصل المباشر.','Registration activities do not imply that every service is available at every branch. Confirm service availability directly.')}</p></section>
<section class="section container" style="padding-top:0"><div class="contact-box"><h3>{t('التواصل المهني','Business contact')}</h3>{site.organization.email?<a class="text-link" href={`mailto:${site.organization.email}`} data-event="email_click"><Icon name="mail" size={18}/>{site.organization.email}</a>:<p>{t('ستُضاف قناة التواصل المخصصة للأعمال بعد اعتمادها من المؤسسة. يمكنك الاطلاع على البيانات التجارية والتعريفية أعلاه.','A dedicated business contact channel will be added once confirmed by the establishment. Registration and profile information are available above.')}</p>}</div></section>
</>}

{page==='visit'&&<>
  <section class="section container content-grid"><div class="info-panel"><div class="eyebrow"><Icon name="pin" size={18}/>{t('معلومات الوجهة','DESTINATION DETAILS')}</div><h2>{branch.name[lang]}</h2><span class="status" data-opening-status data-branch={JSON.stringify(branch)}>{t('تحقق من أوقات الزيارة','Check visiting hours')}</span><dl class="info-list"><div><dt>{t('المدينة','City')}</dt><dd>{branch.city[lang]}</dd></div><div><dt>{t('العنوان','Address')}</dt><dd>{branch.address[lang]||t('يُضاف العنوان التفصيلي بعد التأكيد','Detailed address to be confirmed')}</dd></div><div><dt>{t('أوقات العمل','Opening hours')}</dt><dd>{Object.keys(branch.hours).length?Object.entries(branch.hours).map(([day,periods])=><div>{[t('الأحد','Sunday'),t('الاثنين','Monday'),t('الثلاثاء','Tuesday'),t('الأربعاء','Wednesday'),t('الخميس','Thursday'),t('الجمعة','Friday'),t('السبت','Saturday')][Number(day)]}: <span dir="ltr">{(periods as string[][]).map(period=>period.join(' – ')).join(' / ')||t('مغلق','Closed')}</span></div>):t('تُعلن بعد اعتماد جدول الفرع','To be published after branch confirmation')}</dd></div><div><dt>{t('الأسعار والباقات','Prices & packages')}</dt><dd><a class="text-link" href={href(lang,'offers')}>{t('عرض التفاصيل','View details')}</a></dd></div></dl>{branch.mapsUrl?<a class="button" href={branch.mapsUrl} target="_blank" rel="noopener noreferrer" data-event="directions_click"><Icon name="pin" size={18}/>{t('افتح الاتجاهات','Get directions')}</a>:<p class="info-note">{t('ستظهر الاتجاهات وحالة الافتتاح عند تأكيد موقع الفرع وجدول العمل.','Directions and opening status will appear once the branch location and schedule are confirmed.')}</p>}</div>
  <div><div class="eyebrow">{t('قبل ما تنطلقون','BEFORE YOU SET OFF')}</div><h2 style="font-size:28px;margin-bottom:25px">{t('تفاصيل تساعدكم تخططون.','A little planning goes a long way.')}</h2><div class="visit-checklist">{[{icon:'people',title:t('العمر والطول','Age & height'),text:t('تأكد من شروط اللعبة المناسبة لأطفالك.','Check ride requirements for your children.')},{icon:'clock',title:t('الوقت المناسب','Opening times'),text:t('راجع الأوقات الخاصة بالمواسم والإجازات.','Check seasonal and holiday opening times.')},{icon:'pin',title:t('الوصول والمرافق','Access & amenities'),text:t('استفسر عن المواقف والمدخل والجلسات وإمكانية الوصول.','Ask about parking, entrances, seating and accessibility.')},{icon:'bag',title:t('الدفع والعروض','Payment & offers'),text:t('تأكد من وسائل الدفع وشروط الباقات قبل الشراء.','Confirm payment methods and package terms before buying.')}].map(item=><div class="checklist-item"><Icon name={item.icon} size={24}/><h3>{item.title}</h3><p>{item.text}</p></div>)}</div></div></section>
  <section class="section container" style="padding-top:0"><div class="eyebrow">{t('إجابات تهمكم','USEFUL ANSWERS')}</div><h2>{t('أسئلتكم، قبل الزيارة.','Your questions, before you visit.')}</h2><div class="faq">{site.faqs.map(faq=><details><summary>{faq.question[lang]}<Icon name="plus" size={20}/></summary><p>{faq.answer[lang]}</p></details>)}</div></section>
</>}

{page==='offers'&&<section class="section container"><div class="section-heading"><div><div class="eyebrow">{t('مرح أكثر لكل زيارة','MORE JOY IN EVERY VISIT')}</div><h2>{t('خيارات تناسب زيارتكم.','Options for your visit.')}</h2></div></div>{pricing.length?<div class="price-grid">{pricing.map(item=><article class="price-card"><h3>{item.title[lang]}</h3><strong>{item.amount} {t('ر.س','SAR')}</strong><p>{item.description[lang]}</p></article>)}</div>:<div class="empty-state"><Icon name="bag" size={36}/><h2>{t('الباقات قيد التحديث','Packages are being updated')}</h2><p>{t('نعمل على استكمال الأسعار والباقات المعتمدة. ستجدون هنا تفاصيل واضحة عن السعر وما تتضمنه كل باقة بمجرد توفرها.','Confirmed pricing and packages are being prepared. You’ll find clear prices and details of what each package includes when available.')}</p><a class="button" href={href(lang,'experiences')}>{t('استكشف التجارب','Explore experiences')}<Icon name="arrow" size={18} class="direction-arrow"/></a></div>}<div style="margin-top:45px"><h2 style="font-size:27px">{t('العروض الحالية','Current offers')}</h2>{offers.length?<div class="price-grid" style="margin-top:25px">{offers.map(item=><article class="price-card"><h3>{item.title[lang]}</h3><p>{item.description[lang]}</p><p>{item.end}</p></article>)}</div>:<p class="section-note">{t('لا توجد عروض منشورة حاليًا. تابع هذه الصفحة للتحديثات.','There are no published offers at the moment. Check this page for updates.')}</p>}</div></section>}

{page==='privacy'&&<section class="section container privacy-copy"><h2>{t('البيانات التي نجمعها','Information we collect')}</h2><p>{t('لا يحتوي الإصدار الحالي على تسجيل حسابات أو دفع إلكتروني. نموذج الرحلات يجهّز ملخصًا داخل المتصفح من بيانات المنسق والمجموعة؛ لا يرسلها إلى خادم ولا يحفظها. لا نطلب أسماء الأطفال أو تواريخ ميلادهم.','The current version has no visitor accounts or online payments. The trip form prepares a summary locally in your browser using organizer and group details. It does not send data to a server or save it. We do not request children’s names or dates of birth.')}</p><h2>{t('تفضيلات العرض','Display preferences')}</h2><p>{t('يحفظ الموقع اختيار الوضع الليلي أو النهاري في متصفحك فقط. يمكنك حذف هذا التفضيل بمسح بيانات الموقع من المتصفح. يتم تحديد اللغة من رابط الصفحة.','The website stores your day or night display preference only in your browser. Clear the website’s browser data to remove it. Language is determined by the page URL.')}</p><h2>{t('الخدمات الخارجية','External services')}</h2><p>{t('تُحمّل خطوط الموقع من Google Fonts، وقد يستقبل مزود الخدمة معلومات الطلب التقنية مثل عنوان الإنترنت. وعند فتح رابط خارجي، تنطبق سياسة خصوصية الجهة المقصودة.','Website fonts load from Google Fonts, whose provider may receive technical request information such as your IP address. External links are governed by the destination’s privacy policy.')}</p><h2>{t('الاستضافة والقياس','Hosting and measurement')}</h2><p>{t('قد يعالج مزود الاستضافة سجلات تقنية لتشغيل الموقع وحمايته. لا يرسل الموقع حاليًا أحداث الاستخدام إلى أي منصة تحليلات خارجية. تُراجع هذه السياسة قبل تفعيل أدوات قياس أو جمع بيانات إضافية.','The hosting provider may process technical logs to operate and protect the website. The website currently sends no usage events to an external analytics platform. This policy will be reviewed before enabling additional analytics or data collection.')}</p><h2>{t('الجهة المسؤولة','Responsible establishment')}</h2><p>{site.organization.name[lang]} — {t('السجل التجاري','Commercial registration')}: <b dir="ltr">{site.organization.registration}</b>.</p><p><a class="text-link" href={href(lang,'business')+'#registration'}>{t('بيانات المؤسسة','Establishment details')}<Icon name="arrow" class="direction-arrow" size={18}/></a></p></section>}
{page==='trips'&&<Trips lang={lang}/>}
