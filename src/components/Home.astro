---
import Icon from './Icon.astro';
import {tr, href, asset, site, type Lang} from '../lib/site';
const {lang} = Astro.props as {lang:Lang};
const t = (ar:string,en:string)=>tr(lang,ar,en);
---
<section class="hero container">
  <div class="hero-copy">
    <div class="eyebrow"><span class="little-line"></span>{t('من جدة… تبدأ الحكاية','FROM JEDDAH, WITH JOY')}</div>
    <h1>{t('عالم من المرح،','A world of joy.')}<br/><span>{t('يجمعنا.','Together.')}</span></h1>
    <p class="hero-description">{t('تجارب ترفيهية للعائلة، ومساحة تصنع الذكريات. مرحبًا بكم في جزيرة المرح.','Family entertainment and a place to make memories. Welcome to Fun Island.')}</p>
    <div class="button-row"><a class="button" href={href(lang,'experiences')} data-event="hero_explore_click">{t('اكتشف الجزيرة','Discover the island')}<Icon name="arrow" size={19} class="direction-arrow"/></a><a class="text-link" href={href(lang,'about')}>{t('تعرّف على المؤسسة','Meet the establishment')}<span>↗</span></a></div>
    <div class="hero-details"><span><Icon name="pin" size={18}/>{t('جدة، السعودية','Jeddah, Saudi Arabia')}</span><span><Icon name="people" size={19}/>{t('تجارب تجمع العائلة','Experiences for the family')}</span></div>
  </div>
  <div class="hero-visual">
    <img class="island-hero-image" src={asset('images/island-concept.webp')} alt={t('رسم تصوري لجزيرة ألعاب بألوان الأزرق والأصفر والأخضر، لا يمثل الموقع الفعلي','Conceptual amusement island in blue, yellow and green; not a depiction of the actual venue')} width="1254" height="1254" fetchpriority="high"/>
    <div class="visual-topline"><span>THE FUN ISLAND</span><span class="day-label"><Icon name="sun" size={18}/>{t('أهلًا بالمرح','HELLO, JOY')}</span></div>
    <div class="visual-caption"><span>{t('جزيرة واحدة. حكايات كثيرة.','One island. Many stories.')}</span><span class="round-arrow"><Icon name="arrow" size={19} class="direction-arrow"/></span></div>
    <span class="concept-label">{t('رسم تصوري للهوية','Brand concept illustration')}</span>
  </div>
</section>
<section class="identity-strip"><div class="container identity-strip-inner"><span class="strip-label">{t('جزيرة المرح','FUN ISLAND')}</span><p>{t('البهجة في التجربة. والثقة في التفاصيل.','Joy in the experience. Trust in the details.')}</p><a href={href(lang,'about')+'#registration'}><Icon name="building" size={20}/>{t('تعرّف على بيانات المؤسسة','View establishment details')}<Icon name="arrow" size={17} class="direction-arrow"/></a></div></section>
<section class="section container" id="discover">
  <div class="section-heading"><div><div class="eyebrow">{t('لكل زيارة حكاية','A STORY IN EVERY VISIT')}</div><h2>{t('اختر طريقتك للمرح.','Find your kind of fun.')}</h2></div><a class="text-link" href={href(lang,'experiences')}>{t('كل التجارب','All experiences')}<Icon name="arrow" size={18} class="direction-arrow"/></a></div>
  <div class="experience-grid">{site.games.filter(g=>g.featured).map((game,index)=><a class={`experience-card experience-${index}`} href={href(lang,'experiences')+`#${game.id}`}><div class="experience-card-top"><span class="number">0{index+1}</span><span class="experience-icon"><Icon name={game.icon} size={54}/></span></div><div class="experience-card-bottom"><div><span class="card-kicker">{[t('حركة وحماس','MOVEMENT & THRILLS'),t('لحظات عائلية','FAMILY MOMENTS'),t('مهارة وتحدّي','SKILL & CHALLENGE')][index]}</span><h3>{game.title[lang]}</h3></div><span class="card-arrow"><Icon name="arrow" size={21} class="direction-arrow"/></span></div></a>)}</div>
  <p class="section-note">{t('تعرّف على أنواع التجارب، وراجع إتاحة الألعاب وشروط استخدامها قبل الزيارة.','Explore the types of experiences. Check game availability and requirements before visiting.')}</p>
</section>
<section class="about-band"><div class="container about-grid"><div><div class="eyebrow">{t('أكثر من وجهة ترفيهية','MORE THAN A DESTINATION')}</div><h2>{t('نصنع مساحة للبهجة،','Creating room for joy,')}<br/>{t('ونبني علاقات تدوم.','and lasting connections.')}</h2></div><div><p>{t('مؤسسة ملاهي جزيرة المرح الاقتصادية، مؤسسة سعودية في مجال الترفيه. نجمع تحت اسم جزيرة المرح تجربة الزائر والتواصل مع قطاع الأعمال، بهوية واضحة ومعلومات متاحة.','Fun Island Economic Amusement Establishment is a Saudi establishment in the entertainment sector. Under the Fun Island name, we bring together visitor experiences and business connections, with a clear identity and accessible information.')}</p><a class="text-link" href={href(lang,'about')}>{t('المزيد عن المؤسسة','More about us')}<Icon name="arrow" size={18} class="direction-arrow"/></a></div></div></section>
<section class="section container"><div class="business-callout"><div class="business-symbol"><Icon name="building" size={54}/></div><div class="business-copy"><div class="eyebrow">{t('للشركات والجهات','FOR BUSINESSES & ORGANIZATIONS')}</div><h2>{t('فرص نتشاركها. وأثر نصنعه.','Shared opportunities. Meaningful impact.')}</h2><p>{t('تعرّف على أنشطة المؤسسة وابدأ حوارًا حول التعاون والفعاليات والفرص التجارية.','Explore our establishment’s activities and start a conversation about collaboration, events and business opportunities.')}</p></div><a class="button button-light" href={href(lang,'business')}>{t('الأعمال والشراكات','Business & partnerships')}<Icon name="arrow" size={18} class="direction-arrow"/></a></div></section>
<section class="visit-band"><div class="container visit-band-inner"><div class="visit-band-title"><span class="visit-icon"><Icon name="pin" size={35}/></span><div><span class="eyebrow">{t('الزيارة الحلوة تبدأ بخطوة','GOOD DAYS START HERE')}</span><h2>{t('نشوفكم في الجزيرة.','See you on the island.')}</h2></div></div><a class="button" href={href(lang,'visit')}>{t('خطط لزيارتك','Plan your visit')}<Icon name="arrow" size={19} class="direction-arrow"/></a></div></section>
