---
import Icon from './Icon.astro';
import IslandMap from './IslandMap.astro';
import Waves from './Waves.astro';
import {tr, href, asset, site, type Lang} from '../lib/site';
const {lang} = Astro.props as {lang:Lang};
const t = (ar:string,en:string)=>tr(lang,ar,en);
const photos = ['bumper-cars.webp','carousel.webp','arcade.webp'];
---
<section class="play-hero"><div class="container play-hero-grid">
  <div class="play-copy"><span class="hello-tag"><Icon name="sun" size={21}/>{t('يا أهلًا بأحلى طلعة!','A GOOD DAY TO PLAY!')}</span><h1>{t('خلّوا الروتين،','Less routine.')}<br/><em>{t('وتعالوا نلعب!','More play!')}</em></h1><p>{t('لفة، ضحكة، وتحدّي جديد. في جزيرة المرح، أحلى وقت هو اللي نقضيه سوا.','One more ride. One more laugh. One more challenge. At Fun Island, the best moments are the ones we share.')}</p><div class="button-row"><a class="button" href={href(lang,'experiences')} data-event="hero_explore_click">{t('يلا، نكتشف الألعاب','Let’s find your fun')}<Icon name="arrow" size={21} class="direction-arrow"/></a><a class="text-link" href={href(lang,'visit')}>{t('رتّبوا طلعتكم','Plan your day')}<Icon name="pin" size={18}/></a></div><div class="hero-footnote"><span class="mini-ticket">FUN ISLAND</span><span>{t('جزيرة المرح · جدة','Fun Island · Jeddah')}</span></div></div>
  <div class="play-collage"><figure class="carousel-frame"><img src={asset('images/carousel.webp')} alt={t('صورة تعبيرية لألعاب الأحصنة الدوارة بأضوائها الدافئة','Illustrative photograph of a carousel with warm carnival lights')} width="1100" height="1300" fetchpriority="high"/><figcaption>{t('لفة ثانية؟ أكيد!','One more ride? Always.')}</figcaption></figure><div class="joy-sticker"><Icon name="spark" size={25}/><span>{t('المرح','GOOD')}<br/>{t('يجمعنا','TIMES')}</span></div><a class="arcade-snapshot" href={href(lang,'experiences')+'#arcade'}><img src={asset('images/arcade.webp')} alt={t('صورة تعبيرية لألعاب الأركيد','Illustrative arcade photograph')} width="500" height="370"/><span>{t('جاهز للتحدّي؟','Game on?')}<Icon name="arrow" class="direction-arrow" size={18}/></span></a><span class="collage-note">{t('صور تعبيرية لأجواء الترفيه','Illustrative amusement photography')}</span></div>
</div></section>
<div class="fun-ribbon" aria-hidden="true"><div>{[0,1,2].map(()=> <><span>{t('العب','PLAY')}</span><Icon name="spark" size={25}/><span>{t('اضحك','LAUGH')}</span><Icon name="spark" size={25}/><span>{t('جرّب','EXPLORE')}</span><Icon name="spark" size={25}/><span>{t('عيدها!','REPEAT!')}</span><Icon name="spark" size={25}/></>)}</div></div>
<section class="section container play-discover" id="discover"><div class="section-heading"><div><div class="eyebrow">{t('على جوّكم','YOUR DAY. YOUR WAY.')}</div><h2>{t('كل واحد وله','Everyone has a')} <span class="orange-word">{t('لعبته.','favorite.')}</span></h2></div><a class="text-link" href={href(lang,'experiences')}>{t('شوفوا كل التجارب','See every experience')}<Icon name="arrow" size={19} class="direction-arrow"/></a></div><div class="ride-posters">{site.games.filter(g=>g.featured).map((game,index)=><a class={'ride-poster poster-'+index} href={href(lang,'experiences')+'#'+game.id}><div class="poster-photo"><img src={asset('images/'+photos[index%photos.length])} alt={t('صورة تعبيرية لتجربة '+game.title.ar,'Illustrative photograph for '+game.title.en)} width="700" height="650" loading="lazy"/><span class="poster-label">{[t('حماس على الآخر','FULL-ON FUN'),t('لفة ورا لفة','ROUND WE GO'),t('مين يتحدّى؟','CHALLENGE ON')][index]}</span></div><div class="poster-title"><span><small>{[t('سيارات ومغامرة','CARS & ADVENTURE'),t('ألعاب عائلية','FAMILY RIDES'),t('ألعاب إلكترونية','ARCADE GAMES')][index]}</small><h3>{game.title[lang]}</h3></span><span class="round-arrow"><Icon name="arrow" size={23} class="direction-arrow"/></span></div></a>)}</div><p class="section-note">{t('الصور تعبيرية. تُراجع الألعاب المتاحة وشروط استخدامها قبل الزيارة.','Illustrative photography. Check available games and their requirements before visiting.')}</p></section>
<Waves/><section class="island-discovery"><div class="container"><div class="section-heading"><div><div class="eyebrow">{t('انزلوا على شاطئ المرح','WELCOME ASHORE')}</div><h2>{t('جزيرتكم…','Your island.')} <span class="orange-word">{t('اكتشفوها!','Go explore!')}</span></h2></div><span class="map-weather"><span class="map-sun"><Icon name="sun" size={35}/></span><span class="map-moon"><Icon name="moon" size={35}/></span></span></div><IslandMap lang={lang}/></div></section><Waves tone="green"/>
<section class="outing-section"><div class="container outing-grid"><div><span class="hello-tag">{t('للرحلات والمدارس والمجموعات','FOR SCHOOLS & GROUPS')}</span><h2>{t('مع أصحابكم،','With your friends,')}<br/>{t('المرح يصير','the fun gets')} <em>{t('أكثر.','even better.')}</em></h2><p>{t('تخططون لرحلة مدرسية أو زيارة جماعية؟ جهّزوا عدد المشاركين والفئة العمرية والموعد المقترح، وتعرّفوا على تفاصيل التنسيق.','Planning a school trip or a group visit? Prepare your group size, age range and preferred date, and explore how to coordinate the visit.')}</p><a class="button button-yellow" href={href(lang,'trips')}>{t('كل تفاصيل الرحلات','Explore group visits')}<Icon name="arrow" class="direction-arrow" size={20}/></a></div><div class="outing-tickets">{[['experiences','01',t('وش نلعب؟','What shall we play?'),t('استكشفوا الألعاب والتجارب','Find games and experiences')],['trips','02',t('نطلع مع المجموعة؟','Coming as a group?'),t('معلومات الرحلات والتنسيق','Trip details and coordination')],['visit','03',t('كيف نجهّز الزيارة؟','Ready for your visit?'),t('معلومات الفرع وإجابات تهمكم','Branch details and useful answers')]].map(([path,num,title,desc])=><a href={href(lang,path)} class="outing-ticket"><span class="ticket-number">{num}</span><div><h3>{title}</h3><p>{desc}</p></div><Icon name="arrow" class="direction-arrow"/></a>)}</div></div></section>
<section class="container business-teaser"><div><div class="eyebrow">{t('للأعمال والشركات','FOR BUSINESSES & COMPANIES')}</div><h2>{t('فرصة تعاون؟ تعرّفوا علينا.','A collaboration in mind? Meet us.')}</h2><p>{t('تعريف المؤسسة وبياناتها التجارية ومجالات نشاطها في مكان واحد.','Our establishment, registration details and activity areas, together in one place.')}</p></div><a class="text-link" href={href(lang,'business')}>{t('الأعمال وبيانات المؤسسة','Business & establishment details')}<Icon name="arrow" class="direction-arrow" size={20}/></a></section>
