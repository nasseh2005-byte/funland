---
import Icon from './Icon.astro';
import {asset,href,tr,type Lang} from '../lib/site';
const {lang}=Astro.props as {lang:Lang};
const t=(ar:string,en:string)=>tr(lang,ar,en);
const choices=[
  {id:'family',icon:'wheel',image:'carousel.webp',game:'carousel',title:t('وقت للعائلة','Family time'),note:t('جولة هادئة وضحكات تتكرر.','Gentle rides and another reason to smile.'),area:t('واحة العائلة','Family oasis'),theme:'mint'},
  {id:'adventure',icon:'car',image:'bumper-cars.webp',game:'cars',title:t('حماس الحركة','Ready for action'),note:t('ادخلوا أجواء التحدي والمغامرة.','Step into the thrill of the challenge.'),area:t('شاطئ المغامرة','Adventure shore'),theme:'sun'},
  {id:'electronic',icon:'gamepad',image:'arcade.webp',game:'arcade',title:t('روح التحدّي','Game on'),note:t('مهارة ومنافسة في كل جولة.','Skill and friendly competition in every round.'),area:t('جزيرة التحدّي','Challenge island'),theme:'coral'}
];
---
<script src="../scripts/chooser.ts"></script>
<section class="adventure-picker section container" aria-labelledby="picker-title" data-chooser>
  <div class="picker-heading"><div><span class="eyebrow"><Icon name="spark" size={18}/>{t('اختر مزاج الرحلة','PICK YOUR KIND OF FUN')}</span><h2 id="picker-title">{t('أي مغامرة تناديكم اليوم؟','Where will your day take you?')}</h2><p>{t('ثلاثة أبواب إلى عالم الجزيرة. اختاروا ما تحبّون، ثم ادخلوا المنطقة مباشرة.','Three ways into the island. Pick a mood and step straight into its world.')}</p></div><span class="picker-index" dir="ltr" aria-hidden="true">01 / 03</span></div>
  <div class="picker-tabs" role="tablist" aria-label={t('اختر نوع التجربة','Choose an experience')}>
    {choices.map((choice,index)=><button id={'picker-tab-'+choice.id} type="button" role="tab" aria-controls={'picker-panel-'+choice.id} aria-selected={index===0?'true':'false'} tabindex={index===0?'0':'-1'} data-choose={choice.id}><Icon name={choice.icon} size={22}/><span>{choice.title}</span><Icon name="arrow" size={17} class="direction-arrow"/></button>)}
  </div>
  <div class="picker-panels">{choices.map((choice,index)=><article class={'picker-panel '+choice.theme} id={'picker-panel-'+choice.id} role="tabpanel" aria-labelledby={'picker-tab-'+choice.id} data-choice-panel={choice.id} hidden={index!==0}>
    <div class="picker-photo"><img src={asset('images/'+choice.image)} alt={t('صورة تعبيرية لمنطقة '+choice.area,'Illustrative photograph for '+choice.area)} width="720" height="500" loading="lazy"/><span>{t('صورة تعبيرية','Illustrative photo')}</span></div>
    <div class="picker-copy"><span class="picker-area"><Icon name={choice.icon} size={19}/>{choice.area}</span><h3>{choice.title}</h3><p>{choice.note}</p><a class="button button-light" href={href(lang,'experiences')+'#'+choice.game}>{t('ادخلوا المنطقة','Explore this area')}<Icon name="arrow" size={19} class="direction-arrow"/></a><span class="picker-number" aria-hidden="true">0{index+1}</span></div>
  </article>)}</div>
</section>
<style>
.adventure-picker{padding-block:76px 83px}.picker-heading{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:26px}.picker-heading h2{font-size:clamp(38px,4vw,55px)}.picker-heading p{color:var(--muted);font-size:15px;margin-top:10px;max-width:620px}.picker-index{border:1px solid var(--line);border-radius:50px;padding:7px 17px;color:var(--green);font-size:13px;white-space:nowrap}.picker-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-bottom:16px}.picker-tabs button{min-height:69px;display:flex;align-items:center;gap:13px;padding:12px 19px;text-align:start;border:1px solid var(--line);border-radius:13px;background:var(--surface);color:var(--text);font-family:var(--heading);font-size:23px;font-weight:750;transition:transform .25s,background .25s,border-color .25s}.picker-tabs button svg:last-child{margin-inline-start:auto}.picker-tabs button:hover{transform:translateY(-3px)}.picker-tabs button[aria-selected=true]{background:#ffcf3d;border-color:#ad8d27;color:#233c2d;box-shadow:0 4px 0 #ad8d27}.picker-panel{display:grid;grid-template-columns:1.08fr 1fr;gap:0;min-height:380px;border:1px solid var(--line);border-radius:21px;overflow:hidden;background:#e5eecf;color:#263e31}.picker-panel.sun{background:#f8df8a}.picker-panel.coral{background:#f0cfbb}.picker-photo{min-height:380px;position:relative;overflow:hidden}.picker-photo img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}.picker-photo span{position:absolute;bottom:14px;inset-inline-start:14px;background:#fff9e5ef;color:#29412f;padding:5px 11px;border-radius:7px;font-size:11px}.picker-copy{position:relative;display:flex;flex-direction:column;align-items:start;justify-content:center;padding:50px clamp(32px,4vw,68px);overflow:hidden}.picker-area{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600}.picker-copy h3{font-size:clamp(37px,4vw,60px);margin-top:16px;position:relative;z-index:1}.picker-copy p{font-size:17px;line-height:1.8;margin-top:10px;position:relative;z-index:1}.picker-copy .button{margin-top:28px;position:relative;z-index:1}.picker-number{position:absolute;bottom:-60px;inset-inline-end:9px;font:bold 245px/1 var(--heading);opacity:.085;pointer-events:none}.picker-panel[hidden]{display:none!important}
:global([data-theme=dark]) .picker-panel{background:#294c3c;color:#fdf1d1;border-color:#54735d}:global([data-theme=dark]) .picker-panel.sun{background:#69522d}:global([data-theme=dark]) .picker-panel.coral{background:#633d38}:global([data-theme=dark]) .picker-tabs button[aria-selected=true]{background:#d9aa4a;color:#172f27;border-color:#9b742d}
@media(max-width:850px){.picker-tabs button{font-size:18px;padding:10px 13px}.picker-panel{grid-template-columns:1fr 1fr}.picker-photo{min-height:340px}.picker-copy{padding:32px}.picker-copy h3{font-size:39px}.picker-copy p{font-size:15px}}
@media(max-width:650px){.adventure-picker{padding-block:48px 54px}.picker-heading{align-items:start}.picker-heading h2{font-size:37px}.picker-heading p{font-size:14px}.picker-index{display:none}.picker-tabs{gap:7px}.picker-tabs button{font-size:16px;min-height:62px;gap:6px;justify-content:center;padding:8px 5px;text-align:center;flex-direction:column;line-height:1.25}.picker-tabs button svg:last-child{display:none}.picker-tabs button svg:first-child{width:20px;height:20px}.picker-panel{grid-template-columns:1fr}.picker-photo{min-height:220px}.picker-copy{padding:25px 24px 29px}.picker-copy h3{font-size:37px;margin-top:8px}.picker-copy p{font-size:14px;margin-top:5px}.picker-copy .button{margin-top:18px}.picker-number{font-size:135px;bottom:-35px}}
@media(prefers-reduced-motion:reduce){.picker-tabs button{transition:none}}
</style>
